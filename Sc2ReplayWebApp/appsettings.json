{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=sc2replays.db"
  },
  "BattleNet": {
    "ClientId": "YOUR_CLIENT_ID",
    "ClientSecret": "YOUR_CLIENT_SECRET",
    "CallbackPath": "/signin-battlenet",
    "Region": "us",
    "AuthorizationEndpoint": "https://oauth.battle.net/authorize",
    "TokenEndpoint": "https://oauth.battle.net/token",
    "UserInformationEndpoint": "https://oauth.battle.net/userinfo"
  }
}
